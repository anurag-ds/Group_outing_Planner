# Copy to .env.local and fill in. Never commit .env.local.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
# Optional: enables the AI agent (notes -> Qloo tags), explanations and the LLM-only comparison.
GEMINI_API_KEY=
# Optional: change if the default alias stops working.
GEMINI_MODEL=gemini-flash-latest
